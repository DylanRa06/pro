{
  "info": {
    "name": "Patitas al Rescate - Grupal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ampliación basada en los temas anunciados en el PDF individual. Ejecutar carpeta 1; luego promover admin_grupal en pgAdmin antes de carpeta 2. Finalmente carpeta 3. No ejecutar todas sin esta pausa."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usernameUser",
      "value": "adoptante_grupal"
    },
    {
      "key": "usernameAdmin",
      "value": "admin_grupal"
    },
    {
      "key": "passwordDemo",
      "value": "ClaveDemo2026!"
    },
    {
      "key": "tokenUser",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenAlterado",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Registro y acceso USER",
      "item": [
        {
          "name": "01 Registrar USER",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/registrar",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameUser}}\",\n  \"password\": \"{{passwordDemo}}\",\n  \"rol\": \"ADMIN\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Rol público USER\", () => pm.expect(pm.response.json().rol).to.eql(\"USER\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login USER",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameUser}}\",\n  \"password\": \"{{passwordDemo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"tokenUser\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Perfil USER",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/perfil",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUser}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Listar mascotas USER",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/mascotas",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUser}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 USER no registra mascotas",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/mascotas",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUser}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"  Luna  \",\n  \"especie\": \" Perro \",\n  \"edad\": 2,\n  \"estado\": \"ADOPTADA\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Perfil sin token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/perfil",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Perfil token alterado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/perfil",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlterado}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"tokenAlterado\", \"x\" + pm.collectionVariables.get(\"tokenUser\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Login incorrecto",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameUser}}\",\n  \"password\": \"Incorrecta\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Registrar futura cuenta ADMIN",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/registrar",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usernameAdmin}}\",\n  \"password\": \"{{passwordDemo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
