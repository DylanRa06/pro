    {
      "name": "E3 - 1. Registrar usuario",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registrar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registrar"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"adoptante_demo\",\n  \"password\": \"ClaveDemo2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Rol USER y sin contraseña\", function () { const u=pm.response.json(); pm.expect(u.rol).to.eql(\"USER\"); pm.expect(u).not.to.have.property(\"password\"); });"
            ]
          }
        }
      ]
    },
