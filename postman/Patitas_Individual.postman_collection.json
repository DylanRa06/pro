  ],
  "item": [
    {
      "name": "E2 - 1. Registrar Luna",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/mascotas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "mascotas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"  Luna  \",\n  \"especie\": \" Perro \",\n  \"edad\": 2,\n  \"estado\": \"ADOPTADA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Valida reglas\", function () { const m=pm.response.json(); pm.expect(m.nombre).to.eql(\"Luna\"); pm.expect(m.especie).to.eql(\"Perro\"); pm.expect(m.estado).to.eql(\"DISPONIBLE\"); });"
            ]
          }
        }
      ]
    },
