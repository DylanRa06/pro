    {
      "name": "E4 - 1. Login correcto",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"adoptante_demo\",\n  \"password\": \"ClaveDemo2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JWT recibido\", function () { const token=pm.response.json().token; pm.expect(token.split(\".\")).to.have.lengthOf(3); pm.collectionVariables.set(\"token\", token); });"
            ]
          }
        }
      ]
    },
